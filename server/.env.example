# MongoDB Atlas connection string (see docs/deployment.md for how to get one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memory-vault

# Any long random string — used to sign/verify JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the Express server listens on
PORT=5000

# Where the frontend runs, for CORS. Comma-separate multiple origins if needed.
CLIENT_URL=http://localhost:5173
